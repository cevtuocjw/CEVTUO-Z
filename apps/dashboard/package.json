{
  "name": "@cevtuo/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "CEVTUO-Z app — one Taro codebase targeting WeChat Mini Program (weapp) and Android/H5.",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "react"
  },
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": ["last 3 versions", "Android >= 8", "ios >= 12"],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@cevtuo/schema": "workspace:*",
    "@tarojs/components": "4.0.9",
    "@tarojs/helper": "4.0.9",
    "@tarojs/plugin-framework-react": "4.0.9",
    "@tarojs/plugin-platform-h5": "4.0.9",
    "@tarojs/plugin-platform-weapp": "4.0.9",
    "@tarojs/react": "4.0.9",
    "@tarojs/runtime": "4.0.9",
    "@tarojs/shared": "4.0.9",
    "@tarojs/taro": "4.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@tarojs/cli": "4.0.9",
    "@tarojs/taro-loader": "4.0.9",
    "@tarojs/webpack5-runner": "4.0.9",
    "@types/react": "^18.3.12",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "4.0.9",
    "postcss": "^8.4.38",
    "sass": "^1.83.0",
    "webpack": "5.91.0"
  },
  "overrides": {
    "webpack": "5.91.0"
  }
}
