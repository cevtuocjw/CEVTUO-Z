# ── dependencies ──────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ── build output ──────────────────────────────────────────────
dist/
build/
*.tsbuildinfo
.taro-cache/
.swc/

# ── secrets — NEVER commit ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
credentials.json
service-account*.json
.dev.vars
.wrangler/

# ── health data is PRIVATE — must never reach a public Pages site ──
# GitHub Pages is world-readable even when this repo is private.
# Chealth data lives in Cloudflare KV behind a bearer token instead.
data/chealth/

# ⚠️ `data/paperr/` is NOT excluded. The reading history was briefly
# split so that "which book is open right now" stayed private; the reader
# decided the whole dashboard is fine to publish, so nothing under `data/`
# is hidden. Re-read the note in docs/HOSTING.md before making a brand
# private again — chealth above is the worked example.
services/sync-trigger/.cache/

# ── kindle artefacts ──────────────────────────────────────────
# KOReader's stats DB is WAL-mode; never commit raw copies.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
integrations/macos-bridge/tmp/

# ── android ───────────────────────────────────────────────────
integrations/android-shell/.gradle/
integrations/android-shell/build/
integrations/android-shell/app/build/
local.properties
*.apk
*.keystore
*.jks

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes

# ── editors ───────────────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

# Douban lookup cache — scratch data, not project content
.cache/

# ⚠️ The KOReader device config: it carries the DEVICE bearer token in plain
# text (that is unavoidable — it sits on a USB-visible partition). It must never
# also be committed. The token is scoped to one thing, but "a leaked token that
# can only append fake reading stats" is still a leak.
cevtuo-capperr.conf.json
**/cevtuo-capperr.conf.json

# ⚠️ 服务器 .env 的本地备份：里面是 device token、管理口令和 GitHub PAT。
# 绝不能被提交。它是「阿里云那台没了」时的恢复来源之一。
services/ingest/.env.server-backup
