# CEVTUO CAPPERR ingest — 阿里云轻量服务器
#
# 安装:
#   sudo cp systemd/cevtuo-ingest.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cevtuo-ingest
#   journalctl -u cevtuo-ingest -f
#
# ⚠️ ExecStart 指向的是一个 **打包好的单文件**，不是 `src/server.ts`。
# 部署流程见 README 的「部署」一节 —— 这台 CentOS 8 已 EOL，没有 git，
# 也没有包管理器可用，代码是 bun build 出来传过去的。照着这里跑源码是
# 跑不起来的，因为磁盘上根本没有 src/。

[Unit]
Description=CEVTUO CAPPERR ingest (Kindle 阅读统计接收端)
Documentation=https://github.com/cevtuocjw/CEVTUO-Z/blob/main/services/ingest/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ⚠️ 专用非 root 用户。这个进程持有能写仓库的 PAT，
#    让它以 root 跑没有任何好处，只有更大的爆炸半径。
User=cevtuo
Group=cevtuo
WorkingDirectory=/opt/cevtuo-ingest
EnvironmentFile=/opt/cevtuo-ingest/.env
# ⚠️ 绝对路径，且是真实文件不是符号链接。安装器把 bun 放在 /root/.bun/bin，
#    而 /root 是 0700 —— 服务用户穿不进去，systemd 只会给一个没有上下文的
#    203/EXEC（不是「权限被拒」，所以日志里连一句解释都没有）。
ExecStart=/usr/local/bin/bun /opt/cevtuo-ingest/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# 最小权限。这个服务只需要读自己的代码和写日志。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/cevtuo-ingest

[Install]
WantedBy=multi-user.target
