# CEVTUO-Z — environment template
#
# Copy to `.env` for local pipeline runs:   cp .env.example .env
# In CI these come from GitHub repository secrets (Settings → Secrets → Actions).
#
# NEVER commit a filled-in .env. The pipeline refuses to run against a token
# that looks like it was pasted into a tracked file.

# ── Notion ────────────────────────────────────────────────────
# Internal Integration Token: https://www.notion.so/my-integrations
# Starts with `ntn_` or `secret_`.
# ⚠️ After creating it you MUST open each Notion page → "..." → Connections
#    → add the integration, or the API returns 404 for pages that exist.
NOTION_TOKEN=

# Notion page/database IDs (the 32-hex string in the page URL).
# Collect the page → Copy link → the id is the last 32 chars before any `?`.
NOTION_COOF_PAGE_ID=
NOTION_CNSR_PAGES=          # comma-separated: Learn,tech-learn,tech-ai,shopping

# ── Google Drive (Chealth via Health Sync export) ─────────────
# Service-account JSON, minified to ONE line for a GitHub secret.
# Share the Health Sync Drive folder with the service account's client_email as Viewer.
GDRIVE_SA_JSON=
HEALTHSYNC_DRIVE_FOLDER_ID=

# ── Strava (MyWhoosh indoor cycling → Strava) ─────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# ── Cloudflare Worker (server-side only — never sent to the client) ──
# Fine-grained PAT scoped to this ONE repo with **Actions: write** (+ Metadata: read).
# ⚠️ Deliberately NOT `contents: write` — if leaked, that could rewrite the repo.
GH_PAT=
# Shared secret the app sends as `Authorization: Bearer ...` to /api/sync.
DEVICE_TOKEN=
# Cloudflare KV namespace id used for the sync-status cache.
KV_NAMESPACE_ID=

# ── App (shipped to the client — treat as PUBLIC) ─────────────
# Single place to change the data origin. Switching to an ICP-filed domain
# for a published mini program is a one-line edit here, nothing else.
TARO_APP_DATA_BASE=https://apps.cevtuogrnd.com

# ── sync-trigger service (services/sync-trigger) ──────────────
# The ONLY place a credential may live. Mini-program packages are
# decompilable and the H5 bundle is plaintext, so anything shipped in the
# client is public — the app holds CEVTUO_CLIENT_TOKEN and nothing else.

# Fine-grained PAT, scoped to this repo, permission "Actions: write" ONLY.
# Deliberately not contents:write — a leaked actions:write token can trigger
# a workflow, it cannot rewrite the repository.
CEVTUO_GITHUB_TOKEN=

# Bearer the app sends. Grants exactly one ability: asking for a sync.
# Generate: openssl rand -hex 32
CEVTUO_CLIENT_TOKEN=

CEVTUO_REPO_OWNER=cevtuocjw
CEVTUO_REPO_NAME=CEVTUO-Z
CEVTUO_WORKFLOW_FILE=sync.yml
CEVTUO_PORT=8788
# Loopback by default. 0.0.0.0 exposes a GitHub token to the whole LAN.
CEVTUO_BIND=127.0.0.1
CEVTUO_DEBOUNCE_SECONDS=60
CEVTUO_ALLOWED_ORIGINS=https://apps.cevtuogrnd.com,http://localhost:10086
