{
  "name": "cevtuo-z",
  "version": "0.1.0",
  "private": true,
  "description": "CEVTUO-Z — personal data dashboard (COOF / CNSR / CE-PaperR / Chealth)",
  "workspaces": [
    "packages/*",
    "apps/*",
    "pipeline",
    "services/*"
  ],
  "scripts": {
    "app:dev:h5": "bun run --cwd apps/dashboard dev:h5",
    "app:dev:weapp": "bun run --cwd apps/dashboard dev:weapp",
    "app:build:h5": "bun run --cwd apps/dashboard build:h5",
    "app:build:weapp": "bun run --cwd apps/dashboard build:weapp",
    "pipeline": "bun run pipeline/src/cli/sync.ts",
    "typecheck": "tsc -b && tsc --noEmit -p apps/dashboard/tsconfig.json",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} + 2>/dev/null; find . -name dist -type d -prune -exec rm -rf {} + 2>/dev/null; echo done",
    "verify": "bun run scripts/verify-core.ts && bun run scripts/verify-sync-trigger.ts && bun run services/ingest/verify.ts",
    "trigger": "bun run services/sync-trigger/src/server.ts",
    "ingest": "bun run services/ingest/src/server.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.24.1",
    "@babel/plugin-transform-runtime": "^7.24.3",
    "@babel/preset-env": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@babel/preset-typescript": "^7.24.1",
    "@cevtuo/pipeline-core": "workspace:*",
    "@cevtuo/schema": "workspace:*",
    "@cevtuo/sync-trigger": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.2",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
